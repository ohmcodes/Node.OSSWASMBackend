# Copy to .env and fill in. Never commit .env.

# Required. Long random string that signs player tokens and join tickets.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Required. Comma-separated keys your dedicated servers send (x-server-key / -ServerKey=) to register.
SERVER_KEYS=

# Origins allowed to call the API from a browser. "*" is a wildcard.
# Default (when empty): itch.io + *.itch.zone + *.hwcdn.net + localhost.
# Add your own site if you host the web build yourself, e.g. https://play.mygame.com
ALLOWED_ORIGINS=

# Port on the Docker host.
HOST_PORT=3000

# true when behind Nginx Proxy Manager / Cloudflare Tunnel (correct client IPs for rate limiting).
TRUST_PROXY=true

# true = players can post their own scores (simple, but cheatable).
# false = only registered dedicated servers can post scores.
CLIENT_SCORE_SUBMIT=true

# Seconds without a heartbeat before a server disappears from the list.
SERVER_TTL_SECONDS=30

# itch.io login (optional, off while ITCH_CLIENT_ID is empty). docs/01-deploy-backend.md section 6.
# PUBLIC_URL is the https address players reach this backend at; the itch.io OAuth app must list
# <PUBLIC_URL>/v1/auth/itch/callback as its redirect URI. There is no client secret.
PUBLIC_URL=
ITCH_CLIENT_ID=

# Optional
# PLAYER_TOKEN_TTL_SECONDS=2592000
# JOIN_TICKET_TTL_SECONDS=60
# MAX_SAVE_BYTES=1048576
# RATE_LIMIT_PER_MINUTE=300
# LOG_LEVEL=info
